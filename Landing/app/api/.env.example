# India Mind League — API environment template
# Copy to .env and fill in real values.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/iml?schema=public&connection_limit=20&pool_timeout=20"
# connection_limit defaults to (CPU cores * 2 + 1) if omitted — just 5 on a
# 2-core box. That's fine for normal traffic but becomes the real bottleneck
# during a high-concurrency exam batch (see exam batches below), well before
# CPU or RAM. Raise it explicitly; keep it comfortably under Postgres'
# max_connections (check `SHOW max_connections;`).
JWT_ACCESS_SECRET="<generate-a-random-string>"
JWT_REFRESH_SECRET="<generate-a-random-string>"
PORT=3000

# Paytm — get merchant credentials from the team; never commit real values here.
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=
PAYTM_WEBSITE=
PAYTM_REQUEST_URL=
PAYTM_CALLBACK_URL=
PAYTM_STATUS_URL=

# Where we redirect the browser after Paytm's callback resolves
FRONTEND_PAYMENT_RESULT_URL=http://localhost:4200/account/payments

# Base URL used to build the {TestLink} magic link in exam batch reminders
FRONTEND_BASE_URL=http://localhost:4200

# Azure Storage — get the SAS token from the team; never commit real values here.
BLOB_SERVICE_SAS_URL=

# Email (Falconide) — get the API key from the team; never commit real values here.
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=

# SMS (ConnectExpress) — get the API key from the team; never commit real values here.
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# Local-dev only: when "true", accepts "123456" as valid for any pending
# login/register OTP, bypassing the real code + expiry check. Leave unset
# (or "false") everywhere except your own local .env — this is a hard,
# indiscriminate auth bypass and must never reach prod.
DEV_OTP_BYPASS=false
