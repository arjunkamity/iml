  @@map("announcements")
}

model Faq {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(10) // FAQ1
  question String  @db.Text
  answer   String  @db.Text
  position Int     @default(0)
  // Inactive FAQs stay editable in the admin list but are excluded from
  // the public /public/faqs response — same soft-hide convention as
  // Grade.active / QuestionCategory.active, not a delete.
  active   Boolean @default(true)

  @@map("faqs")
}

model News {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(10) // NW1
  title     String    @db.VarChar(190)
  category  String?   @db.VarChar(40)
  author    String?   @db.VarChar(90)
  publishOn DateTime? @map("publish_on") @db.Date
  status    String    @default("Draft") @db.VarChar(20) // Draft | Published
  photo     String?   @db.Text
  summary   String?   @db.Text

  @@map("news")
}

model Gallery {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // GA1
  name        String   @db.VarChar(190)
  date        DateTime? @db.Date
  visibility  String   @default("Public") @db.VarChar(20) // Public | Private
  cover       String?  @db.Text
  description String?  @db.Text
  photos      Json     @default("[]")
  status      String   @default("Active") @db.VarChar(20)

  @@map("gallery")
}

model Grievance {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(10) // GV1
  gtype      String    @db.VarChar(30) // Complaint | Feedback | Suggestion
  studentId  Int?      @map("student_id")
  name       String?   @db.VarChar(120)
  contact    String?   @db.VarChar(40)
  subject    String?   @db.VarChar(190)
  message    String    @db.Text
  status     String    @default("New") @db.VarChar(30) // New | In Progress | Resolved
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedBy Int?      @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  student    Student?  @relation(fields: [studentId], references: [id])
  resolver   Admin?    @relation("GrievanceResolver", fields: [resolvedBy], references: [id])
  // The reply chain — everything AFTER the original ticket (message above).
  // Both the student and an admin can post into it; a status change also
  // drops a system-authored entry here so the full history reads as one
  // timeline, not a message thread plus a separately-tracked status field.
  messages   GrievanceMessage[]

  @@map("grievances")
}

model GrievanceMessage {
  id          Int       @id @default(autoincrement())
  grievanceId Int       @map("grievance_id")
  authorType  String    @db.VarChar(10) // student | admin | system
  authorName  String    @db.VarChar(120) // snapshot at post time — survives a name change later
  adminId     Int?      @map("admin_id") // set only when authorType = admin
  body        String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  admin       Admin?    @relation(fields: [adminId], references: [id])

  @@index([grievanceId])
  @@map("grievance_messages")
}

model Notification {
  id            Int       @id @default(autoincrement())
  channel       String    @db.VarChar(12) // EMAIL | SMS
  audience      String    @db.VarChar(60)
  competitionId Int?      @map("competition_id")
  subject       String?   @db.VarChar(190)
  message       String    @db.Text
  html          Boolean   @default(false)
  status        String    @default("Draft") @db.VarChar(20) // Draft | Sent | Failed
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  competition   Competition? @relation(fields: [competitionId], references: [id])
  creator       Admin?    @relation("NotificationCreator", fields: [createdBy], references: [id])

  @@map("notifications")
}

