# India Mind League API - configuration template
# Copy to .env and fill in. For the company server, use secret credentials.
PORT=3000

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IndiaMindLeague
DB_USER=iml_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

JWT_SECRET=
JWT_EXPIRES_IN=1d

OTP_TTL_SECONDS=300

# Azure Storage — get the SAS token from the team; never commit real values here.
BLOB_END_POINT=
SAS_TOKEN=
BLOB_SERVICE_SAS_URL=
FILE_SERVICE_SAS_URL=
QUEUE_SERVICE_SAS_URL=
TABLE_SERVICE_SAS_URL=

# Paytm — get merchant credentials from the team; never commit real values here.
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=
PAYTM_WEBSITE=
PAYTM_REQUEST_URL=
PAYTM_CALLBACK_URL=
PAYTM_STATUS_URL=
# Fixed server-side fee catalogue (rupees)
PAYTM_FEE_STAGE1_REGISTRATION=500
PAYTM_FEE_STAGE3_BOOTCAMP=3500

# Email (transactional)
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=

# SMS
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# Where we redirect the browser after Paytm's callback resolves
FRONTEND_PAYMENT_RESULT_URL=http://localhost:4200/payment/result
