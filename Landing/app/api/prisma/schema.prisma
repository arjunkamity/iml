// ---------------------------------------------------------------------------
// 4.9 Site settings — single-row config for admin-managed branding/tracking.
// Row id is always 1; created on first read if missing.
// ---------------------------------------------------------------------------
model SiteSetting {
  id             Int      @id @default(1)
  logoLightUrl   String?  @map("logo_light_url") @db.VarChar(300) // logo variant for light backgrounds
  logoDarkUrl    String?  @map("logo_dark_url") @db.VarChar(300) // logo variant for dark backgrounds (used in nav/footer today)
  logoMobileUrl  String?  @map("logo_mobile_url") @db.VarChar(300)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(300)
  contactEmail   String?  @map("contact_email") @db.VarChar(190)
  contactPhone   String?  @map("contact_phone") @db.VarChar(30)
  officeAddress  String?  @map("office_address") @db.Text
  // A Google Maps share/embed link for the office address above — shown
  // as a "View on Google Maps" link next to it wherever the address
  // appears. @db.Text (not VarChar) since an embed-style URL with
  // lat/lng/zoom params can run well past a typical VarChar length.
  googleMapsUrl  String?  @map("google_maps_url") @db.Text
  registrationDeadline DateTime? @map("registration_deadline") @db.Timestamptz(6) // target date/time for the homepage Stage 1 countdown
  gaScript       String?  @map("ga_script") @db.Text // raw <script> snippet (e.g. gtag.js), injected into <head> as-is
  analyticsEmbedUrl String? @map("analytics_embed_url") @db.Text // Looker Studio "Embed report" URL, shown in Admin > Traffic
  loadingText    String?  @map("loading_text") @db.VarChar(120)
  loadingImageUrl String? @map("loading_image_url") @db.VarChar(300)

  // Homepage "Who Can Participate?" card
  participateTitle    String? @map("participate_title") @db.VarChar(120)
  participateIntro    String? @map("participate_intro") @db.Text
  participateBullets  String? @map("participate_bullets") @db.Text // one item per line
  participateBtnText  String? @map("participate_btn_text") @db.VarChar(60)
  participateBtnLink  String? @map("participate_btn_link") @db.VarChar(300)
  participatePhotoUrl String? @map("participate_photo_url") @db.VarChar(300)

  // Homepage "Why Join IML?" card
  whyJoinTitle   String? @map("why_join_title") @db.VarChar(120)
  whyJoinBullets String? @map("why_join_bullets") @db.Text // one item per line
  whyJoinBtnText String? @map("why_join_btn_text") @db.VarChar(60)
  whyJoinBtnLink String? @map("why_join_btn_link") @db.VarChar(300)

  // Homepage "Watch IML in Action" video card
  videoUrl     String? @map("video_url") @db.VarChar(300)
  videoCaption String? @map("video_caption") @db.VarChar(120)

  // Certificate template (IML_PARTICIPATION) — the layout and safe-zone
  // math are locked in code (see
  // api/src/certificates/templates/participation-v1.ts) and calibrated
  // against the bundled background art specifically; the background,
  // institution logos, badge/seal, and the two signature images + labels
  // are all admin-configurable. Any unset field falls back to the
  // bundled default asset, never to a broken image — but a replacement
  // background isn't re-checked against the fixed text positions, so a
  // very differently-shaped design could overlap (see the admin hint).
  certBackgroundUrl    String? @map("cert_background_url") @db.VarChar(300)
  certImlLogoUrl       String? @map("cert_iml_logo_url") @db.VarChar(300)
  certAmityLogoUrl     String? @map("cert_amity_logo_url") @db.VarChar(300)
  certBadgeUrl         String? @map("cert_badge_url") @db.VarChar(300)
  certSigLeftImageUrl  String? @map("cert_sig_left_image_url") @db.VarChar(300)
  certSigLeftName      String? @map("cert_sig_left_name") @db.VarChar(120)
  certSigLeftRole      String? @map("cert_sig_left_role") @db.VarChar(120)
  certSigRightImageUrl String? @map("cert_sig_right_image_url") @db.VarChar(300)
  certSigRightName     String? @map("cert_sig_right_name") @db.VarChar(120)
  certSigRightRole     String? @map("cert_sig_right_role") @db.VarChar(120)
  // Body paragraph template — {schoolName}/{studentName} substitute as
  // plain text, {eventNameBold} substitutes to a locked, pre-built bold
  // fragment (see DEFAULT_DESCRIPTION_TEMPLATE in participation-v1.ts).
  // Admin text is always HTML-escaped before substitution, so this can
  // never be used to inject markup.
  certDescriptionTemplate String? @map("cert_description_template") @db.Text

  // Default Demo Exam — always-available "see how the test works" sample
  // exam, unrelated to any real competition. Its question pool is every
  // Question with isDemo:true (see Question.isDemo below) — strictly
  // excluded from every real exam's pool regardless of competition link.
  // A demo run is stateless: nothing is persisted (see
  // PublicService.submitDemoExam), so there's no attempt/score history to
  // configure here, just presentation.
  demoExamTitle         String  @default("Try a Sample Test") @map("demo_exam_title") @db.VarChar(190)
  demoExamDurationMin   Int     @default(10) @map("demo_exam_duration_min")
  demoExamQuestionCount Int?    @map("demo_exam_question_count")
  demoExamActive        Boolean @default(true) @map("demo_exam_active")

  // Whether a student can see their own per-question breakdown (prompt,
  // their answer, the correct answer) on the result-detail page — off
  // shows only the overall score/rank, nothing that exposes exam content.
  // Enforced server-side (StudentService.resultDetail omits the
  // `questions` array entirely when this is false), not just hidden in
  // the UI, since the point is to stop the actual content leaking, not
  // just to declutter the screen.
  showQuestionHistory   Boolean @default(true) @map("show_question_history")

  // Which competition a plain /register visit (no ?comp=CODE in the URL)
  // signs the student up for. Before this existed, PublicService.register()
  // silently fell back to "whichever competition has status=Live with the
  // lowest id" — fine by accident while only one competition was ever Live
  // at a time, but with no admin control over which one wins the moment a
  // second one goes live. No FK — same loosely-coupled-by-code convention
  // as the rest of this table (e.g. certificate template fields); a code
  // that no longer resolves to a competition is treated as unset and
  // register() falls back to the old Live-lookup behavior.
  defaultCompetitionCode String? @map("default_competition_code") @db.VarChar(10)

  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// 4.10 Messaging — event-triggered SMS/email templates + a log of every real
// send attempt made through them. Templates are keyed by a fixed trigger
// name (e.g. REGISTRATION_OTP, PAYMENT_SUCCESSFUL) and seeded once; admins
// edit the body copy, not the key. SMS sends may still bounce until the
// ConnectExpress/DLT template registration is approved — MessageLog records
// the provider's real response either way, it never assumes success.
// ---------------------------------------------------------------------------
model MessageTemplate {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(50) // e.g. REGISTRATION_OTP
  label        String   @db.VarChar(120) // human label shown in the admin UI
  smsBody      String?  @db.VarChar(320) // {Placeholder} tokens, keep under 160 chars where possible
  emailSubject String?  @db.VarChar(190)
  emailBody    String?  @db.Text // {Placeholder} tokens
  active       Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("message_templates")
}

model MessageLog {
  id               Int      @id @default(autoincrement())
  templateKey      String   @map("template_key") @db.VarChar(50)
  channel          String   @db.VarChar(10) // EMAIL | SMS
  recipient        String   @db.VarChar(190) // email address or phone number
  status           String   @db.VarChar(20) // SENT | FAILED | SKIPPED
  providerResponse String?  @map("provider_response") @db.Text
  errorMessage     String?  @map("error_message") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([templateKey])
  @@index([recipient])
  @@map("message_logs")
}

// Mass Email — an admin-composed, one-off email blast to a chosen audience
// (currently: schools/coordinators). Deliberately separate from
// MessageTemplate above: those are fixed lifecycle triggers seeded once
// and edited in place; a Broadcast is created fresh per send, with its
// own ad-hoc subject/body, and never reused as a "template" the way the
// 17 lifecycle keys are. Recipients are materialized as their own rows
// (not just a live query re-run at send time) so the audience a send
// actually went to is a permanent record, and so the queue below can
// claim/retry one recipient at a time — mirrors CertificateJob's
// queue-table-plus-cron-drain shape (see BroadcastQueueService).
model Broadcast {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20) // BC-1001
  subject     String   @db.VarChar(190)
  body        String   @db.Text // HTML, {Placeholder} tokens — same substitution as MessageTemplate
  audience    String   @db.VarChar(30) // 'all' | 'students' | 'schools' | 'custom'
  // Only set (and only meaningful) when audience = 'custom' — the raw
  // admin-entered list (comma/newline/semicolon separated), parsed at
  // preview/send time. Kept as free text rather than pre-split so an
  // edited Draft's textarea round-trips exactly as typed.
  customEmails String? @map("custom_emails") @db.Text
  status      String   @default("Draft") @db.VarChar(20) // Draft | Sending | Sent | Failed
  createdByAdminId Int? @map("created_by_admin_id")
  totalCount  Int      @default(0) @map("total_count")
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  recipients  BroadcastRecipient[]

  @@map("broadcasts")
}

model BroadcastRecipient {
  id          Int       @id @default(autoincrement())
  broadcastId Int       @map("broadcast_id")
  schoolId    Int?      @map("school_id")
  studentId   Int?      @map("student_id")
  email       String    @db.VarChar(190)
  // Snapshotted merge-field values at send-materialization time — a
  // school/student record edited after a broadcast is sent must never
  // change what that already-sent email is later shown to have said.
  vars        Json      @default("{}")
  status      String    @default("Pending") @db.VarChar(20) // Pending | Sent | Failed
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  school      School?   @relation(fields: [schoolId], references: [id])
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

// ---------------------------------------------------------------------------
// 4.11 Certificates — one row per issued certificate. This is the record
// the public /verify/:certificateNumber page and QR code look up against
// (see api/src/certificates/). Phase 1 scope: issuance is a manual/scripted
// insert (there's no admin "Issue Certificate" button or async job queue
// yet — that's certificate_jobs in the original requirements doc, Phase 3).
// certificateNumber is globally unique and is the public identifier;
// nothing about the internal id is ever exposed.
// ---------------------------------------------------------------------------
model Certificate {
  id                Int      @id @default(autoincrement())
  certificateNumber String   @unique @map("certificate_number") @db.VarChar(40) // e.g. IML-AMT-2026-000001
  registrationId    Int      @map("registration_id")
  certificateType   String   @default("PARTICIPATION") @map("certificate_type") @db.VarChar(30)
  templateCode      String   @map("template_code") @db.VarChar(60)
  templateVersion   Int      @map("template_version")
  status            String   @default("ISSUED") @db.VarChar(20) // ISSUED | REVOKED
  eventName         String   @map("event_name") @db.VarChar(190) // snapshotted at issuance — a later-renamed exam shouldn't change what an old certificate says it was for
  pdfUrl            String?  @map("pdf_url") @db.VarChar(500)
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  registration      Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
  @@map("certificates")
}

// A queued "issue + email this participation certificate" job — enqueued
// the moment a Stage-1 attempt is submitted (see StudentService.submitExam),
// drained by a cron worker rather than rendered inline: at real scale
// (5000+ participants) a burst of submissions at the end of a batch window
// would otherwise mean a burst of simultaneous Chromium PDF renders
// competing with the live exam experience for the same server. The worker
// only drains this queue when NO exam is currently open (see
// CertificateQueueService.isAnyExamRunning), and processes strictly one
// job at a time even then.
model CertificateJob {
  id             Int       @id @default(autoincrement())
  registrationId Int       @unique @map("registration_id") // one Stage-1 attempt per registration -> at most one job ever
  eventName      String    @db.VarChar(190)
  status         String    @default("Pending") @db.VarChar(20) // Pending | Sent | Failed
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@map("certificate_jobs")
}

// ---------------------------------------------------------------------------
// 4.12 Views (queried via raw SQL — not mapped as models)
// ---------------------------------------------------------------------------
// CREATE VIEW leaderboard AS ...
// CREATE VIEW dashboard_summary AS ...
