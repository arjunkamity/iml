// India Mind League — Prisma schema (PostgreSQL)
// Source: D:\INDIA MIND LEAGUE\Landing\admin\backend-api-plan.md §4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 4.1 Identity & access
// ---------------------------------------------------------------------------

model Admin {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(190)
  passwordHash String    @map("password_hash") @db.Text
  role         String    @default("Editor") @db.VarChar(30) // Super Admin | Editor | Viewer
  status       String    @default("Active") @db.VarChar(20) // Active | Disabled
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  modules      AdminModule[]
  refreshTokens RefreshToken[]
  resolvedGrievances Grievance[] @relation("GrievanceResolver")
  notificationsCreated Notification[] @relation("NotificationCreator")
  grievanceReplies GrievanceMessage[]

  @@map("admins")
}

// replaces ad.modules[]
model AdminModule {
  adminId    Int    @map("admin_id")
  moduleCode String @map("module_code") @db.VarChar(30) // dash, comp, reg, sch, q, ex, nt, ad, lb, res, pay, spon, plan, prize, ann, news, gal, gri
  admin      Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([adminId, moduleCode])
  @@map("admin_modules")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  tokenHash String   @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("refresh_tokens")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String?  @db.VarChar(190) // register/reset OTPs are always email-keyed; login OTPs use whichever of email/phone the student signed in with
  phone     String?  @db.VarChar(20)
  code      String   @db.VarChar(10)
  purpose   String   @default("login") @db.VarChar(30) // login | register | reset
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose])
  @@index([phone, purpose])
  @@map("otps")
}

// ---------------------------------------------------------------------------
// 4.2 Participants
// ---------------------------------------------------------------------------

model School {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(10) // S01
  name        String  @db.VarChar(190)
  city        String? @db.VarChar(90)
  // Two free-text phone fields for the school office itself (not the
  // coordinator's own login phone below) — `contact` is shown as "Primary
  // Phone", `contactSecondary` as "Secondary Phone". Both optional; a
  // school that only has one number just leaves the second blank instead
  // of jamming both into `contact` as a comma-separated pair.
  contact     String? @db.VarChar(40)
  contactSecondary String? @map("contact_secondary") @db.VarChar(40)
  coordinator String? @db.VarChar(120)
  // The school's own official/institutional address — reception, front
  // office, an info@ alias — distinct from `email` below. Never used as a
  // login identity and never carries {LoginId}/{LoginPassword}; it exists
  // so a broadcast can address the institution itself (see "All Schools"
  // in Admin > Mass Email) separately from the one named coordinator who
  // actually signs in.
  schoolEmail String? @map("school_email") @db.VarChar(190)
  // Login identity for the school's own portal (/schools) — set by an
  // admin (see Admin > Schools) since a school doesn't self-register.
  // Both nullable: a school with neither set simply can't sign in yet.
  // Same nullable-until-first-login shape as Student.passwordHash — a
  // school signs in with OTP first and sets its own password from there,
  // exactly like a student does.
  email       String? @db.VarChar(190)
  phone       String? @db.VarChar(20)
  passwordHash String? @map("password_hash")
  // True right after a default password (the school's own phone number) is
  // set — by admin creation/bulk-upload or the one-time backfill — until
  // the school completes the forced first-login OTP-verify + password-set
  // flow (see AuthService.completeSchoolFirstLogin). False for any school
  // that has ever set its own password normally.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // False only for a school auto-created from a student typing a name that
  // wasn't already in the list at registration (see
  // PublicService.resolveOrCreateSchoolId) — an admin hasn't looked at it
  // yet, so it might be a duplicate/typo of an existing school, or just
  // unfamiliar. True for every admin-created school (manual add or bulk
  // upload) and for every school that already existed before this field
  // was added — those are all already-trusted records, not pending review.
  verified    Boolean @default(true)
  students    Student[]
  broadcastRecipients BroadcastRecipient[]

  @@map("schools")
}

// Admin-managed grade / class lookup — drives every grade dropdown in the app
// (register page, competitions, registrations, questions, exams, student profile).
// The value stored in Student.grade / Competition.grades / etc. is `name`.
model Grade {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(20) // 9, 10, 11, 12, 9-12
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("grades")
}

// Admin-managed list of question categories (IQ / EQ / Values / …), shown in
// every category dropdown in the app (Question Bank filter, question form).
// The value stored in Question.category is `name` — same pattern as Grade.
model QuestionCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(20) // IQ, EQ, Values
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("question_categories")
}

model Student {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // R1001
  name        String   @db.VarChar(120)
  grade       String   @db.VarChar(6) // 9, 10, 11, 12
  schoolId    Int?     @map("school_id")
  dob         DateTime? @db.Date
  gender      String?  @db.VarChar(12)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(190)
  passwordHash String? @map("password_hash")
  parent      String?  @db.VarChar(120)
  parentPhone String?  @map("parent_phone") @db.VarChar(20)
  address     String?  @db.Text
  photoUrl    String?  @map("photo_url") @db.Text
  // Has this student already been shown the one-time "Congratulations —
  // try the Demo Exam" modal on their dashboard? Set true the first time
  // it's dismissed or acted on; never shown again after that.
  demoPromptSeen Boolean @default(false) @map("demo_prompt_seen")
  // Soft-remove, one-way: an archived student is hidden from the default
  // admin Registrations view, is invisible to every "does this
  // email/phone already have an account" lookup (so re-registering with
  // the same email/phone creates a genuinely new Student rather than
  // reusing the archived one), and never receives another SMS/email —
  // see MessagingService.dispatch(). Nothing else is deleted; every
  // existing registration/attempt/payment/certificate stays exactly as
  // it was. There's deliberately no unarchive action.
  archived    Boolean  @default(false)
  // Admin-generated direct-login token (Admin > Registrations > "Generate
  // Login Link") — bypasses OTP entirely, for when a student's own inbox
  // is unreachable (e.g. testing against a disposable address that never
  // receives mail). No fixed expiry; regenerating overwrites the old value
  // outright, which is the only revoke path — see AuthService.consumeStudentAccessToken.
  accessToken String?  @unique @map("access_token") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school      School?  @relation(fields: [schoolId], references: [id])
  registrations Registration[]
  grievances  Grievance[]
  broadcastRecipients BroadcastRecipient[]
  assessmentSubmissions AssessmentSubmission[]

  @@map("students")
}

// ---------------------------------------------------------------------------
// 4.3 Competitions & stages
// ---------------------------------------------------------------------------

model Competition {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(10) // C01
  title       String    @db.VarChar(190)
  grades      String    @db.VarChar(20) // 9-12
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  status      String    @default("Draft") @db.VarChar(20) // Draft | Open | Live | Closed
  isMulti     Boolean   @default(false) @map("is_multi")
  // How a student's result is displayed to them (and printed on the
  // certificate): PERCENT (percent only) | GRADE (letter grade only) |
  // FRACTION (raw "score/total" only, e.g. "80/100"). Admin views always
  // show the full raw score regardless of this setting.
  scoringMode String    @default("PERCENT") @map("scoring_mode") @db.VarChar(20)
  // INSTANT = certificate is auto-queued the moment Stage 1 is submitted
  // (original behavior). MANUAL = nothing is issued automatically and the
  // student's own "generate now" button is disabled — an admin must issue
  // each certificate explicitly from Results.
  certificateMode String @default("INSTANT") @map("certificate_mode") @db.VarChar(20)
  description String?   @db.Text
  photoUrl    String?   @map("photo_url") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stages      CompetitionStage[]
  registrations Registration[]
  questions   Question[]
  questionGroups QuestionGroup[]
  // Which Future Readiness season (see ScorecardSeason) this competition belongs to,
  // and, optionally, which of the framework's level scales it uses instead of the
  // season's default. Both null for competitions that are not part of a scorecard.
  seasonId    Int?      @map("season_id")
  scaleKey    String?   @map("scale_key") @db.VarChar(30)
  season      ScorecardSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  exams       Exam[]
  notifications Notification[]
  sponsorEvents SponsorEvent[]
  prizes      Prize[]
  questionRules CompetitionQuestionRule[]

  @@map("competitions")
}

model CompetitionStage {
  id            Int       @id @default(autoincrement())
  competitionId Int       @map("competition_id")
  position      Int
  name          String    @db.VarChar(120)
  mode          String    @db.VarChar(30) // Online | Offline | Hybrid | Peer Interview
  passMark      Decimal   @map("pass_mark") @db.Decimal(5, 2) // percentage 0-100
  // Caps how many attempts can advance out of this stage — null means no
  // cap (every attempt that clears passMark qualifies immediately, the
  // original behavior). Set, it defers the qualify/advance decision from
  // submitExam() time to an admin-run ranked selection once the stage
  // closes — see SelectionService.
  maxQualifiers Int?      @map("max_qualifiers")
  isFree        Boolean   @default(true) @map("is_free")
  price         Decimal   @default(0) @db.Decimal(10, 2)
  description   String?   @db.Text
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  rules         StageRule[]
  registrationStages RegistrationStage[]
  attempts      Attempt[]
  payments      Payment[]
  panel         PanelStage?

  @@unique([competitionId, position])
  @@map("competition_stages")
}

model StageRule {
  id       Int    @id @default(autoincrement())
  stageId  Int    @map("stage_id")
  rule     String @db.Text
  position Int    @default(0)
  stage    CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("stage_rules")
}

// ---------------------------------------------------------------------------
// 4.4 Registrations & progression (pay-to-accept)
// ---------------------------------------------------------------------------

model Registration {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(10) // R1001
  studentId     Int      @map("student_id")
  competitionId Int      @map("competition_id")
  status        String   @default("Registered") @db.VarChar(30) // Registered | Test Taken | Qualified | Eliminated
  // Was @db.Date (date-only) until 2026-09-11 — every registration ever
  // made had its time-of-day silently discarded at write time (Postgres
  // truncates CURRENT_TIMESTAMP to midnight for a `date` column), which is
  // why the admin Registrations table showed "00:00" for every single row.
  // Existing rows can't be recovered (the time was never stored), but this
  // stops it happening to any future registration.
  registeredAt  DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  student       Student  @relation(fields: [studentId], references: [id])
  competition   Competition @relation(fields: [competitionId], references: [id])
  stages        RegistrationStage[]
  attempts      Attempt[]
  payments      Payment[]
  batchAssignments ExamBatchAssignment[]
  magicLinks    ExamMagicLink[]
  certificates  Certificate[]
  certificateJob CertificateJob?
  scorecardReports ScorecardReport[]

  @@unique([studentId, competitionId])
  @@map("registrations")
}

// The per-stage journey of one participant.
model RegistrationStage {
  registrationId Int       @map("registration_id")
  stageId        Int       @map("stage_id")
  status         String    @default("Locked") @db.VarChar(30)
  // Locked (next stage not yet paid/unlocked) | Paid | Attempted | Qualified | Eliminated
  score          Decimal?  @db.Decimal(5, 2)
  qualified      Boolean?
  unlockedAt     DateTime? @map("unlocked_at") @db.Timestamptz(6)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  // How many of Exam.maxAttempts this registration has used at this
  // stage. Tracked here rather than by counting Attempt rows because a
  // re-attempt DELETES the prior Attempt once the new one is submitted
  // (see StudentService.submitExam) — this counter is the only durable
  // record that an earlier attempt ever happened.
  attemptsUsed   Int       @default(0) @map("attempts_used")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  stage          CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@id([registrationId, stageId])
  @@map("registration_stage")
}

// ---------------------------------------------------------------------------
// 4.5 Assessments
// ---------------------------------------------------------------------------

model Question {
  id            Int        @id @default(autoincrement())
  code          String     @unique @db.VarChar(12) // Q1
  competitionId Int?       @map("competition_id")
  grade         String     @db.VarChar(6)
  category      String     @db.VarChar(20) // IQ | EQ | Values
  qtype         String     @default("text") @db.VarChar(12) // text | video | image
  media         String?    @db.Text
  mode          String     @default("single") @db.VarChar(10) // single | multi
  label         String?    @db.VarChar(60)
  ref           String?    @db.VarChar(30)
  timeLimitSecs Int?       @map("time_limit_secs")
  prompt        String     @db.Text
  options       Json       @default("[]")
  correct       Json       @default("[]") // correct index(es)
  // Demo-only question — pulled ONLY by the public Default Demo Exam
  // (PublicService.getDemoExam/submitDemoExam). StudentService.loadQuestions()
  // (every real exam's pool) explicitly filters isDemo:false regardless of
  // competitionId, so a demo question can never surface in a real exam.
  isDemo        Boolean    @default(false) @map("is_demo")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  competition   Competition? @relation(fields: [competitionId], references: [id])
  // Assessment questions live in the same Question Bank as exam questions
  // (same editor, same CSV upload, same categories) but are NEVER part of an
  // exam pool: assessmentId is non-null, and every pool query (real exam in
  // StudentService.loadQuestions, demo exam in PublicService) filters
  // assessmentId: null. They carry no correct answer — each option scores
  // optionPoints[i] instead (see common/assessment-scoring.ts).
  assessmentId  Int?       @map("assessment_id")
  optionPoints  Json       @default("[]") @map("option_points")
  // Panel-rated forms: what each rating level looks like, and how much this competency counts.
  optionHints   Json       @default("[]") @map("option_hints")
  weight        Decimal    @default(1) @db.Decimal(5, 2)
  assessment    Assessment? @relation(fields: [assessmentId], references: [id])
  // Membership of a Question Group (see QuestionGroup). A grouped question is
  // served only through its group, never from the single-question pool, so the
  // pool queries filter groupId: null. groupPosition is its order inside the
  // group. Both null for every ordinary question.
  groupId       Int?       @map("group_id")
  groupPosition Int?       @map("group_position")
  group         QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attemptAnswers AttemptAnswer[]

  @@index([assessmentId])
  @@index([groupId])
  @@map("questions")
}

// ---------------------------------------------------------------------------
// Future Readiness scorecard configuration (everything an admin can change
// without a deploy). A framework is the versioned set of dimensions, level
// scales and the shared competency library; a season ties a framework to an
// edition (label, ID pattern) and to competitions. Published frameworks are
// immutable: edit a copy ("new version") instead, so reports already issued
// never change.
// ---------------------------------------------------------------------------
model ScorecardFramework {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(10) // FW1
  name        String    @db.VarChar(190)
  version     Int       @default(1)
  status      String    @default("Draft") @db.VarChar(20) // Draft | Published | Archived
  parentId    Int?      @map("parent_id") // the framework this one was copied from
  notes       String?   @db.Text
  // { dimensions: [...], scales: [...], defaultScale, competencies: [...] } — see
  // common/scorecard-config.ts for the shape and the rules a framework must meet
  // to be published.
  config      Json      @default("{}")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      ScorecardFramework?  @relation("FrameworkVersions", fields: [parentId], references: [id], onDelete: SetNull)
  copies      ScorecardFramework[] @relation("FrameworkVersions")
  seasons     ScorecardSeason[]

  @@map("scorecard_frameworks")
}

model ScorecardSeason {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(10) // SE1
  name         String   @db.VarChar(190)
  editionLabel String   @map("edition_label") @db.VarChar(120) // "India Mind League – 1st Edition"
  // Display ID pattern, e.g. IML-{YYYY}-{#####}. The display ID is separate from
  // the internal database id.
  idPattern    String   @default("IML-{YYYY}-{#####}") @map("id_pattern") @db.VarChar(60)
  year         Int?
  frameworkId  Int      @map("framework_id")
  scaleKey     String?  @map("scale_key") @db.VarChar(30) // default scale for its competitions
  // The wording (strengths, growth text, challenge, disclaimer ...) its reports use.
  libraryId    Int?     @map("library_id")
  // The report layout (sections, labels, colours) its reports use.
  templateId   Int?     @map("template_id")
  // How its reports are released and shared: consentRequired, notifyStudent, linkValidDays (see common/report-access.ts).
  deliverySettings Json  @default("{}") @map("delivery_settings")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  framework    ScorecardFramework @relation(fields: [frameworkId], references: [id])
  library      ScorecardLibrary?  @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  template     ScorecardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  competitions Competition[]

  @@map("scorecard_seasons")
}

// The wording the scorecard uses, kept as data so no report text lives in code. A
// library holds text items; each item has a DRAFT (what an editor is working on)
// and, once approved, an immutable approved VERSION that reports read. Approving
// writes a new version and never changes an earlier one, so an issued report can
// always be traced to the exact wording it used. See common/content-library.ts for
// the kinds of text, the placeholders and the fallback rules.
model ScorecardLibrary {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(10) // CL1
  name            String   @db.VarChar(190)
  defaultLanguage String   @default("en") @map("default_language") @db.VarChar(10)
  languages       Json     @default("[\"en\"]")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  texts           ScorecardText[]
  seasons         ScorecardSeason[]

  @@map("scorecard_libraries")
}

model ScorecardText {
  id                Int      @id @default(autoincrement())
  libraryId         Int      @map("library_id")
  kind              String   @db.VarChar(30)
  // The competency or dimension this is for ('' when the kind has none; '*' = the default
  // used when nothing more specific is written).
  key               String   @default("") @db.VarChar(60)
  // The level it is for ('' when the kind is not by level; '*' = any level).
  levelKey          String   @default("") @map("level_key") @db.VarChar(30)
  language          String   @default("en") @db.VarChar(10)
  // Order within a list kind (challenge weeks, reflection questions, paragraphs); 0 otherwise.
  position          Int      @default(0)
  title             String?  @db.VarChar(190)
  draftText         String   @map("draft_text") @db.Text
  approvedVersionId Int?     @unique @map("approved_version_id")
  updatedById       Int?     @map("updated_by_id")
  updatedByName     String?  @map("updated_by_name") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  library           ScorecardLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  versions          ScorecardTextVersion[] @relation("TextVersions")
  approvedVersion   ScorecardTextVersion?  @relation("ApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)

  @@unique([libraryId, kind, key, levelKey, language, position])
  @@index([libraryId, kind])
  @@map("scorecard_texts")
}

// Append-only: one row per approval. Never edited, so history is exact.
model ScorecardTextVersion {
  id             Int      @id @default(autoincrement())
  textId         Int      @map("text_id")
  version        Int
  title          String?  @db.VarChar(190)
  text           String   @db.Text
  approvedAt     DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)
  approvedById   Int?     @map("approved_by_id")
  approvedByName String?  @map("approved_by_name") @db.VarChar(120)
  note           String?  @db.VarChar(255)
  textRow        ScorecardText  @relation("TextVersions", fields: [textId], references: [id], onDelete: Cascade)
  approvedFor    ScorecardText? @relation("ApprovedVersion")

  @@unique([textId, version])
  @@map("scorecard_text_versions")
}

// The layout of a scorecard report as data: which sections it has, in what order, the
// labels and headings they print, and the colours. Versioned like a framework: a
// Published template is locked (issued reports depend on it) and a change is made by
// copying it to a new draft version. See common/report-template.ts.
model ScorecardTemplate {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // TP1
  name        String   @db.VarChar(190)
  version     Int      @default(1)
  status      String   @default("Draft") @db.VarChar(20) // Draft | Published | Archived
  parentId    Int?     @map("parent_id")
  notes       String?  @db.Text
  config      Json     @default("{}")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  seasons     ScorecardSeason[]

  @@map("scorecard_templates")
}

// One generated report PDF for a student and stage. A row is also the generation job:
// Queued -> Generating -> Ready (or Failed, retried a few times). Regenerating makes a
// new version row; the one before is marked superseded when the new one is Ready, and
// stays on record. configUsed keeps exactly which framework, template and wording
// versions the PDF was built from, and checksum is the SHA-256 of the file.
model ScorecardReport {
  id               Int      @id @default(autoincrement())
  verificationCode String   @unique @map("verification_code") @db.VarChar(20)
  registrationId   Int      @map("registration_id")
  stagePosition    Int      @map("stage_position")
  version          Int      @default(1)
  status           String   @default("Queued") @db.VarChar(20) // Queued | Generating | Ready | Failed
  attempts         Int      @default(0)
  lastError        String?  @map("last_error") @db.Text
  checksum         String?  @db.VarChar(64)
  sizeBytes        Int?     @map("size_bytes")
  pageCount        Int?     @map("page_count")
  configUsed       Json?    @map("config_used")
  warnings         Json?
  requestedById    Int?     @map("requested_by_id")
  requestedByName  String?  @map("requested_by_name") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  generatedAt      DateTime? @map("generated_at") @db.Timestamptz(6)
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz(6)
  // Release: invisible to everyone until an admin releases it. A later release of a newer
  // version withdraws this one (reason "replaced").
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(6)
  releasedById     Int?      @map("released_by_id")
  releasedByName   String?   @map("released_by_name") @db.VarChar(120)
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnReason  String?   @map("withdrawn_reason") @db.VarChar(255)
  registration     Registration @relation(fields: [registrationId], references: [id])
  file             ScorecardReportFile?
  variants         ScorecardReportVariant[]

  @@unique([registrationId, stagePosition, version])
  @@index([status])
  @@map("scorecard_reports")
}

// The PDF bytes, kept apart from the report row so lists never read them.
model ScorecardReportFile {
  reportId Int    @id @map("report_id")
  data     Bytes
  report   ScorecardReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("scorecard_report_files")
}

// A copy of a report PDF with some sections left out, for an audience (student, parent or
// school) the template hides sections from. Audiences that see everything use the base file.
model ScorecardReportVariant {
  id        Int    @id @default(autoincrement())
  reportId  Int    @map("report_id")
  audience  String @db.VarChar(20)
  checksum  String @db.VarChar(64)
  sizeBytes Int    @map("size_bytes")
  data      Bytes
  report    ScorecardReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, audience])
  @@map("scorecard_report_variants")
}

// Consent to share a student's reports with their parent or school, recorded with the exact
// wording that was accepted.
model ScorecardConsent {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  seasonId    Int?     @map("season_id")
  audience    String   @db.VarChar(20) // parent | school
  libraryCode String?  @map("library_code") @db.VarChar(10)
  textVersion Int?     @map("text_version")
  consentText String   @map("consent_text") @db.Text
  acceptedBy  String   @default("student") @map("accepted_by") @db.VarChar(20)
  acceptedAt  DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  @@index([studentId, audience])
  @@map("scorecard_consents")
}

// A secure link sent to a parent. The token and the verify code are only ever stored hashed.
// The link opens whatever released report the student has for that stage; withdrawing the
// release, or a newer link, revokes it. Too many wrong codes lock it.
model ScorecardShareLink {
  id             Int      @id @default(autoincrement())
  tokenHash      String   @unique @map("token_hash") @db.VarChar(64)
  codeHash       String   @map("code_hash") @db.VarChar(64)
  registrationId Int      @map("registration_id")
  stagePosition  Int      @map("stage_position")
  phone          String   @db.VarChar(20)
  attempts       Int      @default(0)
  openCount      Int      @default(0) @map("open_count")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastOpenedAt   DateTime? @map("last_opened_at") @db.Timestamptz(6)
  createdByName  String?  @map("created_by_name") @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([registrationId, stagePosition])
  @@map("scorecard_share_links")
}

// ---------------------------------------------------------------------------
// Panel evaluation (#75 - #83)
// ---------------------------------------------------------------------------

// A person who rates students. One account across competitions.
model Panelist {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(10) // PN1
  name            String   @db.VarChar(120)
  email           String   @unique @db.VarChar(190)
  phone           String?  @db.VarChar(20)
  status          String   @default("Invited") @db.VarChar(20) // Invited | Active | Disabled
  passwordHash    String?  @map("password_hash")
  inviteTokenHash String?  @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  notes           String?  @db.Text
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  enrolments      PanelEnrolment[]
  ratings         PanelRating[]

  @@map("panelists")
}

// The panel setup and lifecycle of one stage. state: Draft | Ready | Open | Closed |
// Finalized | Selected | Released. formSnapshot freezes the evaluation form when the stage opens.
model PanelStage {
  id            Int      @id @default(autoincrement())
  stageId       Int      @unique @map("stage_id")
  formId        Int?     @map("form_id")
  requiredRaters Int     @default(2) @map("required_raters")
  state         String   @default("Draft") @db.VarChar(20)
  settings      Json     @default("{}")
  formSnapshot  Json?    @map("form_snapshot")
  openedAt      DateTime? @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  finalizedAt   DateTime? @map("finalized_at") @db.Timestamptz(6)
  selectedAt    DateTime? @map("selected_at") @db.Timestamptz(6)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stage         CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  enrolments    PanelEnrolment[]

  @@map("panel_stages")
}

model PanelEnrolment {
  id            Int      @id @default(autoincrement())
  panelStageId  Int      @map("panel_stage_id")
  panelistId    Int      @map("panelist_id")
  // School ids this panelist must not rate (a conflict of interest).
  conflictSchools Json   @default("[]") @map("conflict_schools")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  panelStage    PanelStage @relation(fields: [panelStageId], references: [id], onDelete: Cascade)
  panelist      Panelist   @relation(fields: [panelistId], references: [id], onDelete: Cascade)

  @@unique([panelStageId, panelistId])
  @@map("panel_enrolments")
}

// One panelist's rating of one student at one stage. ratings: { [questionCode]: { optionIndex, points, comment } }
model PanelRating {
  id             Int      @id @default(autoincrement())
  stageId        Int      @map("stage_id")
  registrationId Int      @map("registration_id")
  panelistId     Int      @map("panelist_id")
  status         String   @default("Draft") @db.VarChar(12) // Draft | Submitted
  ratings        Json     @default("{}")
  note           String?  @db.Text
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)
  reopenedAt     DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenedByName String?  @map("reopened_by_name") @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  panelist       Panelist @relation(fields: [panelistId], references: [id])

  @@unique([stageId, registrationId, panelistId])
  @@index([stageId, registrationId])
  @@map("panel_ratings")
}

// An admin's decision where panelists disagree: points per competency that replace the average.
model PanelAdjudication {
  id             Int      @id @default(autoincrement())
  stageId        Int      @map("stage_id")
  registrationId Int      @map("registration_id")
  overrides      Json     @default("{}")
  reason         String   @db.VarChar(500)
  decidedById    Int?     @map("decided_by_id")
  decidedByName  String?  @map("decided_by_name") @db.VarChar(120)
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  @@unique([stageId, registrationId])
  @@map("panel_adjudications")
}

// The computed result of a panel stage per student, written when the stage is finalized.
// Reproducible from the stored ratings and adjudications.
model PanelResult {
  id             Int      @id @default(autoincrement())
  stageId        Int      @map("stage_id")
  registrationId Int      @map("registration_id")
  status         String   @db.VarChar(12) // Rated | NotRated
  percent        Decimal? @db.Decimal(5, 2)
  levelKey       String?  @map("level_key") @db.VarChar(30)
  competencies   Json     @default("[]")
  ratersCount    Int      @default(0) @map("raters_count")
  flagged        Boolean  @default(false)
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([stageId, registrationId])
  @@index([stageId, status])
  @@map("panel_results")
}

// The observer or jury note of a student at a stage: a system draft built from the ratings and
// the recorded notes, the text a panelist is editing, and the text a panelist approved.
model PanelNarrative {
  id             Int      @id @default(autoincrement())
  stageId        Int      @map("stage_id")
  registrationId Int      @map("registration_id")
  systemDraft    String   @map("system_draft") @db.Text
  draftText      String   @map("draft_text") @db.Text
  approvedText   String?  @map("approved_text") @db.Text
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedById   Int?     @map("approved_by_id")
  approvedByName String?  @map("approved_by_name") @db.VarChar(120)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([stageId, registrationId])
  @@map("panel_narratives")
}

// Who changed which configuration, and what. Written for scorecard configuration
// now; shared by the panel and release features later.
model ConfigAuditLog {
  id         Int      @id @default(autoincrement())
  entity     String   @db.VarChar(40)
  entityCode String?  @map("entity_code") @db.VarChar(40)
  action     String   @db.VarChar(40)
  adminId    Int?     @map("admin_id")
  adminName  String?  @map("admin_name") @db.VarChar(120)
  summary    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityCode])
  @@index([createdAt])
  @@map("config_audit_log")
}

// A passage-style group: a topic (title, description, optional image/video)
// with 2+ existing questions as its sub-questions. In an exam a group is one
// atomic unit that takes as many slots as it has sub-questions, each worth one
// mark, and the player shows this header above every sub-question (see
// common/question-draw.ts). The attempt still stores a flat list of question
// ids, so scoring, resume and results are unchanged.
model QuestionGroup {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(12) // QG1
  competitionId Int?     @map("competition_id")
  category      String   @db.VarChar(20)
  title         String   @db.VarChar(190)
  description   String?  @db.Text
  imageUrl      String?  @map("image_url") @db.Text
  videoUrl      String?  @map("video_url") @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  questions     Question[]

  @@index([competitionId])
  @@map("question_groups")
}

// Groups assessments on the admin list (and, later, the student dashboard).
model AssessmentCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(60)
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessments Assessment[]

  @@map("assessment_categories")
}

// Assessments: unscored reflection tools (e.g. "Mind Capacity Check") that sit
// beside, not inside, the competition exam engine. Questions are ordinary
// Question rows linked by assessmentId; `config` holds the capacities, bands,
// practice tips and copy (see common/assessment-scoring.ts for its shape).
// status: Draft | Published | Archived — only Published ones reach students.
model Assessment {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // AS1
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(190)
  summary     String?  @db.Text
  grades      String?  @db.VarChar(40) // "9-12"; null = every grade
  status      String   @default("Draft") @db.VarChar(20)
  // self = taken by the student (the original behaviour); panel = rated by panelists (#75)
  kind        String   @default("self") @db.VarChar(10)
  config      Json     @default("{}")
  categoryId  Int?     @map("category_id")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    AssessmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questions   Question[]
  submissions AssessmentSubmission[]

  @@map("assessments")
}

// One completed run of an assessment. school/grade are snapshotted at submit
// time so later profile edits or school merges don't rewrite history (merges
// re-point schoolId/studentId explicitly — see RegistrationService).
model AssessmentSubmission {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  studentId    Int      @map("student_id")
  schoolId     Int?     @map("school_id")
  grade        String?  @db.VarChar(6)
  answers      Json     // [{ questionId, optionIndex, points }]
  scores       Json     // { THINK: { score, max, band }, ... }
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  // A student takes an assessment once. The unique key makes that race-proof
  // (a double-tap or two tabs can never store two results); an admin can
  // delete a submission to let a student retake.
  @@unique([studentId, assessmentId])
  @@index([assessmentId, submittedAt])
  @@index([schoolId, grade])
  @@map("assessment_submissions")
}

// Per-competition question mix: which categories a student is served and how
// many from each (see StudentService.drawQuestions / common/question-draw.ts).
// A competition with NO rows keeps the original behaviour: the whole tagged
// pool, randomly capped by Exam.questionCount. `category` must match a
// QuestionCategory.name (validated by the admin API, not by an FK, because
// Question.category itself is a plain string).
model CompetitionQuestionRule {
  id            Int    @id @default(autoincrement())
  competitionId Int    @map("competition_id")
  category      String @db.VarChar(20)
  count         Int
  position      Int    @default(0)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, category])
  @@map("competition_question_rules")
}

model Exam {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(10) // E01
  competitionId Int?      @map("competition_id")
  title         String    @db.VarChar(190)
  grade         String?   @db.VarChar(20)
  date          DateTime? @db.Date
  time          DateTime? @db.Time(0)
  durationMin   Int?      @map("duration_min")
  timing        Json      @default("{}") // {mode:'common',secs:60} | {mode:'custom'}
  // How many questions a student is served, drawn at random from every
  // question matching this exam's competition (see
  // StudentService.loadQuestions()). Null/unset = the whole matching
  // pool, same as before this field existed.
  questionCount Int?      @map("question_count")
  // How many times a student may take this exam. 1 (default) preserves
  // the original one-and-done behavior for every exam that existed
  // before this field. On a re-attempt (see StudentService.startExam),
  // the fresh question draw excludes whatever the prior attempt served,
  // and that prior attempt is deleted once the new one is submitted
  // (StudentService.submitExam) — only ever one Attempt row exists per
  // registration+stage at a time, so nothing downstream that assumes
  // "at most one finished attempt" needs to change.
  maxAttempts   Int       @default(1) @map("max_attempts")
  status        String    @default("Scheduled") @db.VarChar(20) // Draft | Scheduled | Live | Closed
  competition   Competition? @relation(fields: [competitionId], references: [id])
  batches       ExamBatch[]
  batchAssignments ExamBatchAssignment[]
  magicLinks    ExamMagicLink[]

  @@map("exams")
}

// Splits one Exam's global window into multiple timed, capacity-capped
// slots so a large registered population never all sit the test at once.
// A student only sees/enters their own assigned batch's window — see
// ExamBatchAssignment and StudentService.resolveExam().
model ExamBatch {
  id          Int      @id @default(autoincrement())
  examId      Int      @map("exam_id")
  label       String   @db.VarChar(60) // "Batch 1 - 10:00 AM"
  startAt     DateTime @map("start_at") @db.Timestamptz(6)
  durationMin Int      @map("duration_min")
  capacity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  assignments ExamBatchAssignment[]

  @@index([examId])
  @@map("exam_batches")
}

// A short-lived, tokenized "magic link" — the {TestLink} placeholder in the
// GO_FOR_IT reminder. Consuming it (AuthService.consumeExamLink) logs the
// student straight in and hands back the exam code to redirect to, so a
// reminder SMS/email can carry a link that drops a student directly onto
// their exam with no manual login step.
model ExamMagicLink {
  id             Int       @id @default(autoincrement())
  token          String    @unique @db.VarChar(24)
  registrationId Int       @map("registration_id")
  examId         Int       @map("exam_id")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([examId])
  @@map("exam_magic_links")
}

// One row per (exam, registration) — a student can only be assigned to a
// single batch of a given exam. examId is denormalized off batch.examId
// purely so that invariant can be a DB-level unique constraint.
model ExamBatchAssignment {
  id             Int      @id @default(autoincrement())
  examId         Int      @map("exam_id")
  batchId        Int      @map("batch_id")
  registrationId Int      @map("registration_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  batch          ExamBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([examId, registrationId])
  @@index([batchId])
  @@index([registrationId])
  @@map("exam_batch_assignments")
}

model Attempt {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(10) // T01
  registrationId Int       @map("registration_id")
  stageId        Int?      @map("stage_id")
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  score          Decimal   @default(0) @db.Decimal(5, 2)
  total          Decimal   @default(0) @db.Decimal(5, 2)
  timing         Json      @default("{}")
  // Client-measured seconds from when this attempt actually started to
  // the moment Submit was pressed — set by the exam page itself, so it's
  // immune to how long the submit REQUEST took to reach the server over a
  // slow connection. Null for attempts submitted before this existed;
  // ranked stage selection falls back to (finishedAt - startedAt) then.
  clientElapsedSecs Int?   @map("client_elapsed_secs")
  // The exact question ids (in serving order) this attempt was given,
  // frozen at startExam() time. submitExam() scores against THIS list,
  // never against a fresh query of the pool — the pool is randomized per
  // attempt, so re-querying at submit time would silently score against
  // a different random set than the student actually saw.
  questionIds    Json?     @map("question_ids")
  // Which question the student was viewing at their last autosave (see
  // StudentService.saveProgress) — resume jumps back here instead of
  // always question 1. Null until the first progress save, or for an
  // attempt finished before this existed.
  lastQuestionId Int?      @map("last_question_id")
  registration   Registration @relation(fields: [registrationId], references: [id])
  stage          CompetitionStage? @relation(fields: [stageId], references: [id])
  answers        AttemptAnswer[]

  @@map("attempts")
}

model AttemptAnswer {
  id         Int       @id @default(autoincrement())
  attemptId  Int       @map("attempt_id")
  questionId Int?      @map("question_id")
  // The question's category as it was when this answer was submitted. Reports
  // (per-area scores) read this, so deleting a question or re-tagging it later
  // can never change a student's recorded area scores. Null for rows saved
  // before this existed that were not backfilled, and for in-progress autosaves
  // (submit rewrites every row); readers fall back to the live question's
  // category.
  category   String?   @db.VarChar(20)
  answer     Json?
  isCorrect  Boolean?  @map("is_correct")
  takenSecs  Int?      @map("taken_secs")
  // How many times the student changed their selected option for this
  // question before moving on/submitting — the first pick never counts,
  // only a later change away from it. Used only as a tie-break in ranked
  // stage selection (fewer changes = more decisive = ranks higher).
  changeCount Int      @default(0) @map("change_count")
  timeUp     Boolean   @default(false) @map("time_up")
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id])

  // Lets saveProgress() upsert one row per question as the student
  // answers, instead of only ever writing these in bulk at final submit.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

// ---------------------------------------------------------------------------
// 4.6 Payments
// ---------------------------------------------------------------------------

model Payment {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(20) // PAY-1001
  registrationId Int       @map("registration_id")
  stageId        Int?      @map("stage_id") // stage being paid for
  amount         Decimal   @db.Decimal(10, 2)
  mode           String    @db.VarChar(30) // UPI | Card | Net Banking | Offline
  status         String    @default("Pending") @db.VarChar(20) // Pending | Paid | Failed
  providerTxn    String?   @map("provider_txn") @db.VarChar(120)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  registration   Registration @relation(fields: [registrationId], references: [id])
  stage          CompetitionStage? @relation(fields: [stageId], references: [id])

  @@map("payments")
}

// ---------------------------------------------------------------------------
// 4.7 Content & comms
