model Announcement {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10) // AN1
  title     String   @db.VarChar(190)
  category  String?  @db.VarChar(40)
  audience  String?  @db.VarChar(60)
  publishOn DateTime? @map("publish_on") @db.Date
  status    String   @default("Draft") @db.VarChar(20) // Draft | Active
  pinned    Boolean  @default(false)
